# 需要配置至少一个 LLM 服务商的 API Key
GLM_API_KEY=
DEEPSEEK_API_KEY=
STEP_API_KEY=
KIMI_API_KEY=
FREELLMAPI_API_KEY=
XFYUN_MAAS_API_KEY=
AGNES_API_KEY=

KAIROCLI_PROVIDER=glm
# 启用应用日志，脱敏后保存在 ~/.kairocli/logs 目录
KAIROCLI_LOG_ENABLED=true
KAIROCLI_LOG_LEVEL=INFO
KAIROCLI_LOG_MAX_BYTES=10485760
KAIROCLI_LOG_MAX_FILES=7
KAIROCLI_RENDERER=inline
# 禁用 TUI 图形界面，使用纯文本模式显示
KAIROCLI_NO_TUI=false
KAIROCLI_TASK_WORKERS=2
KAIROCLI_RUNTIME_API_KEY=
KAIROCLI_SNAPSHOT_ENABLED=true

# 当模型出现临时故障时，自动重试的次数
KAIROCLI_LLM_MAX_RETRIES=2
KAIROCLI_LLM_RETRY_BASE_SECONDS=0.5

# 网络搜索功能（可选），默认自动选择 GLM/Zhipu、SerpAPI 或 SearXNG
KAIROCLI_SEARCH_PROVIDER=
KAIROCLI_ZHIPU_SEARCH_ENGINE=search_std
SERPAPI_API_KEY=
KAIROCLI_SEARXNG_URL=

# 启用模型诊断和推理过程追踪（用于调试）
KAIROCLI_TRACE_ENABLED=false
KAIROCLI_TRACE_REASONING=false

# 邮件服务（腾讯云 SES）：用于 Web 控制台注册验证码与配置自检测试邮件
# 非交互式首次启动 Web 服务时用于创建管理员；交互式启动会直接询问
KAIROCLI_WEB_ADMIN_EMAIL=
# 凭证在腾讯云控制台「访问管理 → API 密钥管理」获取；发信地址需先在 SES 控制台配置发信域名/地址
KAIROCLI_MAIL_ENABLED=false
KAIROCLI_MAIL_PROVIDER=tencent-ses
KAIROCLI_TENCENT_SECRET_ID=
KAIROCLI_TENCENT_SECRET_KEY=
KAIROCLI_MAIL_FROM_ADDRESS=
KAIROCLI_MAIL_FROM_ALIAS=Kairo CLI
KAIROCLI_MAIL_REGION=ap-guangzhou
# 已审核通过的 SES 邮件模板 ID（控制台「邮件推送 → 邮件模板」）
KAIROCLI_MAIL_TEMPLATE_TEST=213821
KAIROCLI_MAIL_TEMPLATE_VERIFICATION=213820
# 验证码有效期（分钟）与重发间隔（秒）
KAIROCLI_MAIL_CODE_TTL_MINUTES=5
KAIROCLI_MAIL_RESEND_SECONDS=60
KAIROCLI_MAIL_MAX_VERIFY_ATTEMPTS=5
